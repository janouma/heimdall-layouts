{
  "name": "heimdall-layouts",
  "version": "1.0.0",
  "description": "heimdall layouts components",
  "type": "module",
  "scripts": {
    "prepare": "husky install",
    "postinstall": "npx @byfrost/utils run command='ln -fs . $prefix'",
    "start": "npx @byfrost/utils run command='node scripts/dev_server'",
    "start:test": "npx @byfrost/utils run envFile=.env.test command='npx http-server --silent -p $testPort -c1 -S -C assets/ssl/cert.pem -K assets/ssl/key.pem --cors'",
    "startd": "npm start &> server.log &",
    "startd:test": "npm run start:test &> server_test.log &",
    "lint": "eslint --no-error-on-unmatched-pattern",
    "standalone-lint": "npm run lint -- '{tests/**/*,lib/**/*,scripts/**/*,src/**/*,index,playwright.config}.{js,cjs,mjs,svelte}'",
    "test": "npx @byfrost/utils run envFile=.env.test command='npm run test:node && npm run setup:test:ui && (npm run test:ui || npm run test:ui:retry -- maxAttempts=4) && npm run teardown:test:ui'",
    "test:node": "npx @byfrost/utils run envFile=.env.test command='node bin/test.js'",
    "setup:test:ui": "npm run dev -- build:shared && npm run dev -- build:all-components",
    "test:ui": "npx @byfrost/utils run envFile=.env.test command='npx playwright test'",
    "test:ui:retry": "npx @byfrost/utils run envFile=.env.test command='node scripts/retry_ui_test.js'",
    "teardown:test:ui": "git checkout layouts && git checkout shared_components",
    "create:layout": "npx @byfrost/utils run command='node scripts/create_layout'",
    "build:layout": "npx @byfrost/utils run command='node scripts/build_layout'",
    "build:all-components": "npx @byfrost/utils run command='node scripts/build_all_components'",
    "build:shared": "npx @byfrost/utils run command='node scripts/build_shared'",
    "create:component": "npx @byfrost/utils run command='node scripts/create_component'",
    "build:component": "npx @byfrost/utils run command='node scripts/build_component'",
    "watch:component": "npx @byfrost/utils run command='node scripts/watch_component'",
    "create:component-test": "npx @byfrost/utils run command='node scripts/create_component_test'",
    "update-production-build": "npx @byfrost/utils run command='node scripts/update_production_build'",
    "dev": "NODE_ENV=development BROWSERSLIST_IGNORE_OLD_DATA=1 npm run"
  },
  "author": "janouma",
  "license": "ISC",
  "volta": {
    "node": "20.12.0",
    "npm": "10.9.3"
  },
  "devDependencies": {
    "@apexearth/egrep": "^1.0.9",
    "@byfrost/core": "^0.5.0",
    "@byfrost/svelte": "^0.5.0",
    "@byfrost/vue": "^0.5.0",
    "@japa/expect": "^2.0.2",
    "@japa/run-failed-tests": "^1.1.1",
    "@japa/runner": "^2.5.1",
    "@japa/spec-reporter": "^1.3.3",
    "@playwright/test": "^1.52.0",
    "browser-sync": "^2.29.3",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-svelte": "^3.10.1",
    "fs-extra": "^11.1.1",
    "globals": "^16.3.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.1.0",
    "nodemon": "^2.0.20",
    "postcss": "^7.0.36",
    "postcss-import": "^12.0.1",
    "postcss-mixins": "^6.2.2",
    "postcss-preset-env": "^6.7.0",
    "postcss-url": "^9.0.0",
    "shelljs": "^0.8.5",
    "simple-git": "^3.19.1",
    "testdouble": "^3.18.0"
  },
  "dependencies": {
    "@byfrost/utils": "^1.0.0",
    "@heimdall/shared-lib": "^1.4.3",
    "basscss": "^8.0.3",
    "basscss-btn": "^1.1.1",
    "element-adapter": "^2.0.1",
    "fuse.js": "^6.0.0",
    "joi": "^17.7.0",
    "svelte": "^4.2.18",
    "vue": "^3.4.38"
  }
}
