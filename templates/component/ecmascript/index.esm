export default class ${
  __COMPONENT_FOLDER__.split('_').map(segment => segment[0].toUpperCase() + segment.slice(1).toLowerCase())
    .join('')
} extends HTMLElement {
  static get observedAttributes () {
    return ['name']
  }

  constructor () {
    super()
    this.attachShadow({ mode: 'open' })
  }

  connectedCallback () {
    this.render()
  }

  attributeChangedCallback () {
    this.render()
  }

  render () {
    const name = this.getAttribute('name') || 'World'
    this.shadowRoot.innerHTML = `
      <link rel="stylesheet" href="\${import.meta.resolve('./styles/index.css')}"/>
      <h1>Hello \${name}!</h1>
    `
  }
}
